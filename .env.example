# Vercel Postgres — o Vercel injeta essas variáveis automaticamente
# quando você conecta um banco Postgres ao projeto no dashboard.
# Copie o valor de POSTGRES_URL do dashboard aqui só se for rodar local.
POSTGRES_URL=

# Senha do painel /admin. Um valor forte, único.
# No Vercel: Project Settings → Environment Variables.
ADMIN_PASSWORD=troque-esta-senha

# WhatsApp do consultor que aparece no link do quiz.
# Formato internacional só com dígitos: 55 + DDD + número.
NEXT_PUBLIC_CONSULTANT_PHONE=5511999999999
NEXT_PUBLIC_CONSULTANT_GREETING=Olá! Acabei de fazer o quiz e quero resgatar o desconto do combo especial.
